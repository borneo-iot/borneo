CONFIG_BORNEO_BOARD_ID="blc06mk1"
CONFIG_BORNEO_BOARD_NAME="BST_BLC06MK1"

CONFIG_ESP32C3_REV_MIN_3=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160

################ Flash ####################################
CONFIG_ESPTOOLPY_FLASHMODE="dio"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"


#################### Core Stuff #########################
CONFIG_BORNEO_ADC_ENABLED=y
CONFIG_BORNEO_ADC_CH0_ENABLED=y
CONFIG_BORNEO_ADC_CH1_ENABLED=y
CONFIG_BORNEO_ADC_CH2_ENABLED=y

################################# Power Supply Measurement ###############################
CONFIG_BORNEO_MEAS_VOLTAGE_SUPPORT=y
CONFIG_BORNEO_MEAS_VOLTAGE_ADC_CHANNEL=0
CONFIG_BORNEO_MEAS_VOLTAGE_FACTOR=16242
CONFIG_LYFI_MEAS_CURRENT_SUPPORT=y
CONFIG_LYFI_MEAS_CURRENT_ADC_CHANNEL=1
CONFIG_LYFI_MEAS_CURRENT_FACTOR=235

################## NTC #########################
CONFIG_LYFI_NTC_SUPPORT=y
CONFIG_LYFI_NTC_ADC_CHANNEL=2
CONFIG_LYFI_NTC_PU_4K7=y

################## Indicator #########################
CONFIG_BORNEO_INDICATOR_ENABLED=y
CONFIG_BORNEO_INDICATOR_GPIO=8


################## LED PWM ########################
CONFIG_LYFI_LED_CHANNEL_COUNT=6
CONFIG_LYFI_LED_CH0_GPIO=5
CONFIG_LYFI_LED_CH1_GPIO=4
CONFIG_LYFI_LED_CH2_GPIO=3
CONFIG_LYFI_LED_CH3_GPIO=19
CONFIG_LYFI_LED_CH4_GPIO=18
CONFIG_LYFI_LED_CH5_GPIO=10

###################### FAN ###########################
CONFIG_LYFI_FAN_CTRL_SUPPORT=y
CONFIG_LYFI_FAN_CTRL_PWM_SUPPORT=y
CONFIG_LYFI_FAN_CTRL_PWM_DEVICE_RMTPWM=y
CONFIG_LYFI_FAN_CTRL_PWM_GPIO=7
CONFIG_LYFI_FAN_CTRL_VREG_SUPPORT=y
CONFIG_LYFI_FAN_CTRL_VREG_DEVICE_RMTPWM=y
CONFIG_LYFI_FAN_CTRL_VREG_GPIO=6
CONFIG_LYFI_FAN_CTRL_VREG_DUTY_MIN=80
CONFIG_LYFI_FAN_CTRL_VREG_DUTY_MAX=208
CONFIG_LYFI_FAN_CTRL_SHUTDOWN_ENABLED=n


############################# THERMAL MANAGEMENT ##############################
CONFIG_LYFI_THERMAL_ENABLED=y


############################### Button ###################################
CONFIG_LYFI_PRESS_BUTTON_ENABLED=y
CONFIG_LYFI_PRESS_BUTTON_GPIO=9

################################## PROTECTION ##################################
CONFIG_LYFI_PROTECTION_ENABLED=y
CONFIG_LYFI_PROTECTION_OVERHEATED_SUPPORT=y
CONFIG_LYFI_PROTECTION_OVERPOWER_SUPPORT=y