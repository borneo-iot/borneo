CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

################ Table of Partitions ######################
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y

######################## General ########################
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_TIMER_TASK_STACK_SIZE=5120

############################### LIBCOAP #####################
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_COAP_TCP_SUPPORT=n
CONFIG_COAP_MBEDTLS_PSK=n
CONFIG_COAP_MBEDTLS_PKI=n
CONFIG_COAP_OSCORE_SUPPORT=n

################## Provisioning #################################
CONFIG_BORNEO_PROV_METHOD_NP=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y

######################## SNTP #############################
CONFIG_LWIP_DHCP_MAX_NTP_SERVERS=3

######################## OTA ###############################
CONFIG_LWIP_IPV6=y